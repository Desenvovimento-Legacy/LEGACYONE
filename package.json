{
  "name": "iaris",
  "version": "0.1.0",
  "private": true,
  "description": "IARIS — Inteligência Artificial para Resultados, Integração e Soluções",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env src/shared/db/migrate.ts",
    "db:dev-roles": "tsx --env-file-if-exists=.env src/shared/db/dev-roles.ts",
    "relay": "tsx --env-file-if-exists=.env src/platform/events/relay-main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "tenant:create": "tsx --env-file-if-exists=.env src/cli/tenant-create.ts",
    "onboard": "tsx --env-file-if-exists=.env src/cli/onboard.ts"
  },
  "dependencies": {
    "nats": "^2.29.3",
    "pg": "^8.23.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
