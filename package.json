{
  "name": "iaris",
  "version": "0.1.0",
  "private": true,
  "description": "IARIS — sistema operacional contábil autônomo",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env src/shared/db/migrate.ts",
    "db:dev-roles": "tsx --env-file-if-exists=.env src/shared/db/dev-roles.ts",
    "relay": "tsx --env-file-if-exists=.env src/platform/events/relay-main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "tenant:create": "tsx --env-file-if-exists=.env src/cli/tenant-create.ts",
    "onboard": "tsx --env-file-if-exists=.env src/cli/onboard.ts",
    "integra:check": "tsx --env-file-if-exists=.env src/cli/integra-check.ts",
    "federal:sync": "tsx --env-file-if-exists=.env src/cli/federal-sync.ts",
    "federal:report": "tsx --env-file-if-exists=.env src/cli/federal-sync.ts --report",
    "web": "tsx --env-file-if-exists=.env src/web/server.ts",
    "cert:check": "tsx --env-file-if-exists=.env src/cli/cert-check.ts",
    "federal:reparse": "tsx --env-file-if-exists=.env src/cli/pgdas-reparse.ts",
    "simples:simular": "tsx --env-file-if-exists=.env src/cli/simples-simulate.ts",
    "auth:init": "tsx --env-file-if-exists=.env src/cli/users.ts init",
    "user:invite": "tsx --env-file-if-exists=.env src/cli/users.ts invite",
    "user:revoke": "tsx --env-file-if-exists=.env src/cli/users.ts revoke",
    "user:list": "tsx --env-file-if-exists=.env src/cli/users.ts list"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "nats": "^2.29.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "unpdf": "^1.8.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
