# Dono do schema: executa migrações. Nunca usado pela aplicação em runtime.
ADMIN_DATABASE_URL=postgres://legacy_owner:legacy_owner_dev@localhost:5432/legacy_one

# Aplicação: papel legacy_app, sujeito a RLS. Não lê nada sem app.tenant_id.
DATABASE_URL=postgres://legacy_app_login:legacy_app_dev@localhost:5432/legacy_one

# Relay do outbox: papel legacy_relay, lê e marca o outbox de todos os tenants.
RELAY_DATABASE_URL=postgres://legacy_relay_login:legacy_relay_dev@localhost:5432/legacy_one

NATS_URL=nats://localhost:4222
TEMPORAL_ADDRESS=localhost:7233

# Cofre local com as credenciais do SERPRO e o certificado do escritório (fora do repositório).
# No Windows o padrão é C:\IARES\cofre\segredos.env. Nunca coloque segredos neste arquivo.
# IARES_SECRETS_FILE=C:\IARES\cofre\segredos.env
